{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://folio.org/schemas/officially-supported-technologies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "definitions", "sections"],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "source": { "$ref": "#/definitions/source" },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneOfSpecifiedVersions", "allOfSpecifiedVersions", "unspecifiedVersions"],
      "properties": {
        "oneOfSpecifiedVersions": { "type": "string", "minLength": 1 },
        "allOfSpecifiedVersions": { "type": "string", "minLength": 1 },
        "unspecifiedVersions": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 14,
      "items": { "$ref": "#/definitions/section" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "frontend-languages" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "frontend-build-tools" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "frontend-first-party-frameworks" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "frontend-third-party-frameworks" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "frontend-build-testing" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "frontend-integration-testing" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-languages" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-build-tools" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-first-party-frameworks" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-third-party-frameworks" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-build-testing" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "backend-integration-testing" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "infrastructure" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "fast-moving-infrastructure" } }, "required": ["id"] } }
      ]
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "documentStatus": { "type": "string", "minLength": 1 },
        "exportDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supportPeriod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement"],
          "properties": {
            "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "statement": { "type": "string", "minLength": 1 }
          }
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "enum": ["exact", "major-line", "minor-line", "minimum", "range", "latest-lts"] },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appliesTo", "strength", "sourceStatement"],
      "properties": {
        "appliesTo": { "type": "string", "minLength": 1 },
        "constraint": { "$ref": "#/definitions/constraint" },
        "strength": { "enum": ["normative", "advisory", "provisional", "contested"] },
        "sourceStatement": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "aliases", "ecosystem", "technologyType", "sourceStatement", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ecosystem": { "enum": ["javascript", "java", "go", "openapi", "infrastructure", "agnostic"] },
        "technologyType": { "enum": ["language", "framework", "library", "build-tool", "testing", "infrastructure"] },
        "sourceStatement": { "type": "string", "minLength": 1 },
        "strength": { "enum": ["normative", "advisory", "provisional", "contested"] },
        "constraint": { "$ref": "#/definitions/constraint" },
        "applicability": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exceptions": { "type": "array", "items": { "$ref": "#/definitions/exception" } },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deprecated", "note"],
          "properties": {
            "deprecated": { "const": true },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "provisional": { "const": true },
        "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "required": ["provisional"] },
          "then": { "properties": { "strength": { "enum": ["advisory", "provisional", "contested"] } } }
        },
        {
          "if": { "properties": { "strength": { "const": "provisional" } }, "required": ["strength"] },
          "then": { "required": ["provisional"] }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "category", "consumer", "versionPolicy", "entries"],
      "properties": {
        "id": {
          "enum": [
            "frontend-languages",
            "frontend-build-tools",
            "frontend-first-party-frameworks",
            "frontend-third-party-frameworks",
            "frontend-build-testing",
            "frontend-integration-testing",
            "backend-languages",
            "backend-build-tools",
            "backend-first-party-frameworks",
            "backend-third-party-frameworks",
            "backend-build-testing",
            "backend-integration-testing",
            "infrastructure",
            "fast-moving-infrastructure"
          ]
        },
        "area": { "enum": ["frontend", "backend", "infrastructure", "fast-moving-infrastructure"] },
        "category": { "enum": ["language", "framework", "build-tool", "testing", "infrastructure"] },
        "consumer": { "enum": ["s007", "s012", "s013", "future"] },
        "versionPolicy": { "enum": ["one-of-specified-versions", "all-of-specified-versions", "unspecified-versions", "provisional"] },
        "sourceStatement": { "type": "string", "minLength": 1 },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } }
      }
    }
  }
}
